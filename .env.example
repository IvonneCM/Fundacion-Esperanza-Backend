# Base de datos — Neon (tiene prioridad si esta definida)
# Copia la URL de Connection details en la consola de Neon.
# Region recomendada: sa-east-1 (San Paulo), la mas cercana a La Paz.
# El nombre de la base debe contener "test" para poder correr pruebas automaticas.
DATABASE_URL=postgresql://USUARIO:CLAVE@ep-xxxx.sa-east-1.aws.neon.tech/fundacion_dev?sslmode=require

# Base de datos — variables separadas (VPS o Postgres local)
# Solo se usan si DATABASE_URL esta vacia.
#DB_HOST=localhost
#DB_PORT=5432
#DB_DATABASE=fundacion_dev
#DB_USERNAME=usuario_app
#DB_PASSWORD=cambiar_esto
#DB_SSL=false

# Puerto del backend
PORT=3000

# development | test | production
NODE_ENV=development

# Autoriza correr las pruebas automaticas contra la base a la que apunte
# DATABASE_URL, aunque su nombre no contenga "test".
# Ponga true solo si esa base es desechable y sus datos se pueden perder.
# En produccion debe ser false.
DB_PERMITIR_TEST=false

# Firma de los JWT. Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambiar_esto

# Almacenamiento de archivos (MinIO o S3) — todavia no lo lee ningun modulo
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_DEFAULT_BUCKETS=documentos
